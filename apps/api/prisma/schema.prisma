generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PostgreSQL migration starts with the tenancy and core asset graph.
// Remaining Mongo-backed domains will be added incrementally on Postgresql.

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  status    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
  users     User[]
  assets    Asset[]

  @@map("tenants")
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  assets    Asset[]

  @@index([tenantId])
  @@map("companies")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  companyId        String   @db.Uuid
  email            String
  firstName        String?
  lastName         String?
  isActive         Boolean  @default(true)
  authVersion      Int      @default(0)
  forcePasswordReset Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments      AssetAssignment[]

  @@unique([tenantId, email])
  @@index([tenantId, companyId])
  @@map("users")
}

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  assetNumber String
  status      String
  condition   String
  serialNumber String?
  model       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments AssetAssignment[]

  @@unique([tenantId, assetNumber])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, companyId])
  @@index([tenantId, status])
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  assetId    String    @db.Uuid
  userId     String    @db.Uuid
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([assetId, returnedAt])
  @@index([userId, returnedAt])
  @@map("asset_assignments")
}
