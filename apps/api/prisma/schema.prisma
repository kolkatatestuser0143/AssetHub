generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  status String @default("active")
  primaryUserId String? @db.Uuid
  primaryEmail String?
  phone String?
  website String?
  logoFileId String?
  logoUrl String?
  faviconFileId String?
  faviconUrl String?
  suspendedAt DateTime?
  suspendedBy String? @db.Uuid
  suspensionReason String?
  companies Company[]
  users User[]
  sites Site[]
  assets Asset[]
  assetAuditEvents AssetAuditEvent[]
  auditEvents AuditEvent[]
  transfers AssetTransfer[]
  maintenance AssetMaintenance[]
  customFieldDefinitions CustomFieldDefinition[]
  vendors Vendor[]
  assetDocuments AssetDocument[]
  warranties Warranty[]
  acknowledgementTemplates AssetAcknowledgementTemplate[]
  acknowledgements AssetAcknowledgement[]
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@map("tenants")
}

model Company {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  code String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users User[]
  sites Site[]
  assets Asset[]
  assetTypes AssetType[]
  maintenance AssetMaintenance[]
  customFieldDefinitions CustomFieldDefinition[]
  vendors Vendor[]
  assetDocuments AssetDocument[]
  warranties Warranty[]
  acknowledgements AssetAcknowledgement[]
  identityProviders IdentityProviderConfig[]
  scimTokens ScimToken[]
  integrations IntegrationInstance[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  accountType String @default("TENANT")
  adminLevel String @default("EMPLOYEE")
  employeeId String?
  email String
  passwordHash String?
  firstName String?
  lastName String?
  jobTitle String?
  phone String?
  mfaMethod String @default("NONE")
  totpSecretEnc String?
  backupCodesHash String[] @default([])
  isActive Boolean @default(true)
  forcePasswordReset Boolean @default(false)
  authVersion Int @default(0)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  accessTokenHash String?
  accessTokenIssuedAt DateTime?
  accessTokenExpiresAt DateTime?
  externalScimId String?
  roleIds String[] @default([])
  departmentId String?
  locationId String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments AssetAssignment[]
  sessions Session[]
  loginHistory LoginHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, email])
  @@index([tenantId, companyId])
  @@index([tenantId, adminLevel, isActive])
  @@index([accountType, accessTokenHash])
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  refreshTokenHash String @unique
  familyId String
  parentTokenHash String?
  ipAddress String?
  userAgent String?
  approxLocation String?
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedReason String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@map("sessions")
}

model LoginHistory {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  success Boolean
  ipAddress String?
  userAgent String?
  reason String?
  occurredAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, occurredAt])
  @@map("login_history")
}

model Site {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  type String @default("plant")
  name String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations Location[]
  @@index([tenantId, companyId])
  @@map("plants")
}

model Location {
  id String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  name String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  departments Department[]
  assets Asset[]
  @@index([siteId])
  @@map("locations")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  locationId String @db.Uuid
  name String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assets Asset[]
  @@index([locationId])
  @@map("departments")
}

model AssetType {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  prefix String?
  separator String @default("-")
  padding Int @default(6)
  nextSequence Int @default(1)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets Asset[]
  @@unique([companyId, name])
  @@map("asset_types")
}

model Vendor {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  contact String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, name])
  @@index([companyId])
  @@map("vendors")
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetTypeId String? @db.Uuid
  assetNumber String
  serialNumber String?
  model String?
  status String @default("in_stock")
  condition String @default("good")
  locationId String? @db.Uuid
  departmentId String? @db.Uuid
  vendorId String? @db.Uuid
  purchaseDate DateTime?
  warrantyProvider String?
  warrantyExpiresAt DateTime?
  qrCodeUrl String?
  barcodeValue String?
  customFields Json?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetType AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]
  auditEvents AssetAuditEvent[]
  transfers AssetTransfer[]
  maintenance AssetMaintenance[]
  documents AssetDocument[]
  warranties Warranty[]
  acknowledgements AssetAcknowledgement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, assetNumber])
  @@index([tenantId, companyId, status, createdAt])
  @@index([tenantId, companyId, assetTypeId, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@map("assets")
}

model Warranty {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @unique @db.Uuid
  provider String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@map("warranties")
}

model AssetMaintenance {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @db.Uuid
  serviceDate DateTime
  serviceType String
  provider String?
  technician String?
  notes String?
  nextServiceDate DateTime?
  attachmentDocumentId String?
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([tenantId, companyId, assetId, serviceDate])
  @@map("asset_maintenance")
}

model AssetAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @db.Uuid
  fromState String?
  toState String
  actorUserId String? @db.Uuid
  reason String?
  occurredAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, occurredAt])
  @@index([tenantId, companyId, occurredAt])
  @@map("asset_audit_events")
}

model AssetAssignment {
  id String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid
  userId String @db.Uuid
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  notes String?
  conditionAtReturn String?
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assetId, returnedAt])
  @@index([userId, returnedAt])
  @@map("asset_assignments")
}

model AssetTransfer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @db.Uuid
  fromUserId String? @db.Uuid
  fromLocationId String? @db.Uuid
  fromDepartmentId String? @db.Uuid
  toUserId String? @db.Uuid
  toLocationId String? @db.Uuid
  toDepartmentId String? @db.Uuid
  requestedByUserId String @db.Uuid
  approvedByUserId String? @db.Uuid
  completedByUserId String? @db.Uuid
  cancelledByUserId String? @db.Uuid
  status String
  requestedAt DateTime @default(now())
  approvedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  approvalNote String?
  completionNote String?
  cancellationNote String?
  reason String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([tenantId, assetId, status])
  @@index([tenantId, requestedAt])
  @@map("asset_transfers")
}

model CustomFieldDefinition {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  key String
  label String
  fieldType String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([tenantId, companyId, key])
  @@index([tenantId, companyId, key])
  @@map("custom_field_definitions")
}

model AssetDocument {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @db.Uuid
  s3Key String
  storageProvider String @default("uploadcare")
  fileName String
  contentType String?
  sizeBytes BigInt?
  documentType String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([tenantId, companyId, s3Key])
  @@index([tenantId, companyId, assetId])
  @@map("asset_documents")
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String? @db.Uuid
  actorUserId String? @db.Uuid
  action String
  targetType String?
  targetId String?
  metadata Json?
  result String?
  route String?
  method String?
  statusCode Int?
  requestId String?
  ipAddress String?
  userAgent String?
  occurredAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, targetId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@map("audit_events")
}

model AssetAcknowledgementTemplate {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  content String
  createdBy String? @db.Uuid
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acknowledgements AssetAcknowledgement[]
  @@index([tenantId, isDefault])
  @@map("asset_acknowledgement_templates")
}

model AssetAcknowledgement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  assetId String @db.Uuid
  employeeId String @db.Uuid
  templateId String @db.Uuid
  templateName String
  contentSnapshot String
  documentId String?
  generatedAt DateTime @default(now())
  generatedByUserId String @db.Uuid
  status String @default("PENDING")
  acknowledgedAt DateTime?
  acknowledgedByUserId String? @db.Uuid
  acknowledgementNote String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  template AssetAcknowledgementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  @@index([tenantId, companyId, assetId, generatedAt])
  @@map("asset_acknowledgements")
}

model AssetReportTemplate {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  description String?
  filters Json
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, name])
  @@map("asset_report_templates")
}

model IdentityProviderConfig {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  protocol String
  name String
  config Json
  attributeMapping Json
  isEnabled Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, name])
  @@map("identity_provider_configs")
}

model ScimToken {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  tokenHash String @unique
  label String?
  deprovisionPolicy String @default("DISABLE_LOGIN")
  revokedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@map("scim_tokens")
}

model ScimSyncLog {
  id String @id @default(uuid()) @db.Uuid
  scimTokenId String @db.Uuid
  operation String
  externalId String?
  payloadHash String?
  success Boolean
  errorMessage String?
  occurredAt DateTime @default(now())
  @@index([scimTokenId, occurredAt])
  @@map("scim_sync_logs")
}

model IntegrationInstance {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  kind String
  provider String
  isMock Boolean @default(false)
  credentialRef String?
  config Json?
  lastSyncAt DateTime?
  lastSyncStatus String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, provider])
  @@map("integration_instances")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  themePreset String @default("starter")
  features Json?
  isActive Boolean @default(true)
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  planId String @db.Uuid
  status String
  startedAt DateTime @default(now())
  endsAt DateTime?
  graceUntil DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements Entitlement[]
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Entitlement {
  id String @id @default(uuid()) @db.Uuid
  subscriptionId String @db.Uuid
  key String
  value Json
  source String @default("plan")
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([subscriptionId, key])
  @@map("entitlements")
}
