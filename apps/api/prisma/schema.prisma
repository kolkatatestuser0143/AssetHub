// ============================================================
// ITAM SaaS — Phase 2: Database Schema (Prisma)
// Postgres. RLS policies applied via raw SQL migration (see
// migrations/xxxx_rls_policies.sql), not expressible in Prisma DSL.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum IdpProtocol {
  SAML
  OIDC
}

enum MfaMethod {
  NONE
  TOTP
  WEBAUTHN // reserved for future use
}

enum AssetLifecycleState {
  REQUESTED
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  LOST_STOLEN
  RETIRED
  DISPOSED
}

enum ScimDeprovisionPolicy {
  DISABLE_LOGIN
  SOFT_DELETE
  NO_ACTION
}

enum IntegrationKind {
  IDENTITY_PROVIDER
  DIRECTORY_SYNC
  ENDPOINT_MGMT
  OTHER
}

// ---------- Tenancy Hierarchy ----------
// Tenant -> Company -> (BusinessUnit -> Plant -> Location) -> Department
// Deliberately NOT a strict required chain: BusinessUnit/Plant/Location/
// Department are each independently nullable on User/Asset so a company
// that doesn't use all five levels isn't forced to fabricate placeholders
// (open decision #1 from Phase 1, resolved this way — flag if you want
// the chain enforced instead).

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies      Company[]
  subscriptions  Subscription[]
  auditEvents    AuditEvent[]
  platformNotes  PlatformAdminNote[]
}

model Company {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name      String
  code      String // short code used in asset prefixes, e.g. "XYZ"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnits    BusinessUnit[]
  users            User[]
  roles            Role[]
  assetTypes       AssetType[]
  assets           Asset[]
  vendors          Vendor[]
  customFieldDefs  CustomFieldDefinition[]
  idpConfigs       IdentityProviderConfig[]
  scimTokens       ScimToken[]
  integrations     IntegrationInstance[]
  auditEvents      AuditEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model BusinessUnit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String

  plants Plant[]

  @@index([companyId])
}

model Plant {
  id             String       @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  name           String

  locations Location[]

  @@index([businessUnitId])
}

model Location {
  id      String @id @default(cuid())
  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id])
  name    String

  departments Department[]
  users       User[]
  assets      Asset[]

  @@index([plantId])
}

model Department {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String

  users  User[]
  assets Asset[]

  @@index([locationId])
}

// ---------- Identity & Access ----------

model User {
  id        String  @id @default(cuid())
  tenantId  String // denormalized for cheap RLS predicates
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // one user -> one company (master prompt §4)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])

  email        String  @unique
  passwordHash String? // null when user is SSO-only
  firstName    String
  lastName     String
  jobTitle     String?
  phone        String?

  mfaMethod       MfaMethod @default(NONE)
  totpSecretEnc   String? // encrypted at rest
  backupCodesHash String[] @default([])

  isActive       Boolean @default(true)
  forcePasswordReset Boolean @default(false)

  externalScimId String? // SCIM externalId, unique per company
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions      Session[]
  loginHistory  LoginHistory[]
  userRoles     UserRole[]
  assetAssignments AssetAssignmentHistory[]
  auditEvents   AuditEvent[] @relation("ActorEvents")

  @@unique([companyId, externalScimId])
  @@index([tenantId])
  @@index([companyId])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  refreshTokenHash  String   @unique
  ipAddress         String?
  userAgent         String?
  approxLocation    String? // derived from IP, not device GPS
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason      String? // e.g. "refresh_reuse_detected"

  @@index([userId])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  success    Boolean
  ipAddress  String?
  userAgent  String?
  reason     String? // failure reason if applicable
  occurredAt DateTime @default(now())

  @@index([userId])
}

model Permission {
  id   String @id @default(cuid())
  key  String @unique // e.g. "asset:read", "billing:manage"
  description String?

  rolePermissions RolePermission[]
}

model Role {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String? // null => tenant-level role
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  isSystem  Boolean @default(false) // seeded roles, not user-deletable

  permissions RolePermission[]
  userRoles   UserRole[]

  @@index([tenantId])
  @@index([companyId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ---------- Assets ----------

model AssetType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String // "Laptop", "Router", ...

  numberingRule AssetNumberingRule?
  assets        Asset[]

  @@unique([companyId, name])
}

model AssetNumberingRule {
  id          String    @id @default(cuid())
  assetTypeId String    @unique
  assetType   AssetType @relation(fields: [assetTypeId], references: [id])

  prefix        String // "LAP"
  separator     String @default("-")
  padding       Int    @default(6)
  nextSequence  Int    @default(1) // incremented in a locked transaction
}

model Asset {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  assetTypeId String
  assetType   AssetType @relation(fields: [assetTypeId], references: [id])
  assetNumber String // generated, e.g. "LAP-XYZ-000001"

  serialNumber String?
  model        String?
  status       AssetLifecycleState @default(IN_STOCK)

  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  purchaseDate DateTime?
  warranty     Warranty?

  qrCodeUrl String?
  barcodeValue String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  AssetAssignmentHistory[]
  auditEvents  AssetAuditEvent[]
  customFields AssetCustomFieldValue[]
  documents    AssetDocument[]

  @@unique([companyId, assetNumber])
  @@index([tenantId])
  @@index([companyId, status])
}

model AssetAssignmentHistory {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  notes      String?

  @@index([assetId])
  @@index([userId])
}

model AssetAuditEvent {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  fromState AssetLifecycleState?
  toState   AssetLifecycleState
  actorUserId String?
  reason    String?
  occurredAt DateTime @default(now())

  @@index([assetId])
}

model CustomFieldDefinition {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  label     String
  fieldType String // "text" | "number" | "date" | "select" ...

  values AssetCustomFieldValue[]

  @@unique([companyId, key])
}

model AssetCustomFieldValue {
  id       String @id @default(cuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  fieldId  String
  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id])
  value    String

  @@unique([assetId, fieldId])
}

model AssetDocument {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  s3Key     String
  fileName  String
  uploadedAt DateTime @default(now())

  @@index([assetId])
}

model Vendor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  contact   String?

  assets Asset[]
}

model Warranty {
  id        String   @id @default(cuid())
  assetId   String   @unique
  asset     Asset    @relation(fields: [assetId], references: [id])
  provider  String?
  expiresAt DateTime?
}

// ---------- Identity Providers / SSO / SCIM ----------

model IdentityProviderConfig {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  protocol  IdpProtocol
  name      String // display name, e.g. "SSIL JumpCloud"

  // protocol-specific config validated at service layer, not DB layer
  config Json

  // attributeMapping: { "providerAttr": "internalField", ... }
  attributeMapping Json

  isEnabled Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model ScimToken {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  tokenHash   String   @unique
  label       String?
  deprovisionPolicy ScimDeprovisionPolicy @default(DISABLE_LOGIN)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  syncLogs ScimSyncLog[]

  @@index([companyId])
}

model ScimSyncLog {
  id          String   @id @default(cuid())
  scimTokenId String
  scimToken   ScimToken @relation(fields: [scimTokenId], references: [id])
  operation   String // "create_user" | "update_user" | "deactivate_user" ...
  externalId  String?
  payloadHash String
  success     Boolean
  errorMessage String?
  occurredAt  DateTime @default(now())

  @@index([scimTokenId])
}

// ---------- Integrations (generic connector framework) ----------

model IntegrationInstance {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  kind      IntegrationKind
  provider  String // "jumpcloud" | "entra" | "mock" ...
  isMock    Boolean @default(false)

  // credentials encrypted at rest, referenced by key into secrets store
  credentialRef String?
  config        Json

  lastSyncAt    DateTime?
  lastSyncStatus String?

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ---------- Billing ----------

model Plan {
  id       String @id @default(cuid())
  name     String @unique
  features Json // feature flags + limits

  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  status    String // "active" | "trialing" | "past_due" | "canceled"
  startedAt DateTime @default(now())
  endsAt    DateTime?

  entitlements Entitlement[]

  @@index([tenantId])
}

model Entitlement {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  key            String // "sso_enabled" | "max_assets" ...
  value          Json

  @@unique([subscriptionId, key])
}

// ---------- Audit (platform-wide, append-only) ----------

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  actorUserId String?
  actor       User?    @relation("ActorEvents", fields: [actorUserId], references: [id])
  action      String // "asset.status_changed" | "user.login" | "role.updated" ...
  targetType  String?
  targetId    String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([companyId, occurredAt])
}

model PlatformAdminNote {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  note      String
  createdAt DateTime @default(now())
}
