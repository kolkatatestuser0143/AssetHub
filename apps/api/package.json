{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:worker": "ts-node src/queue/worker.main.ts",
    "db:seed": "pnpm prisma:normalize && pnpm prisma:generate && ts-node db/seed.ts && ts-node db/migrations/backfill-admin-levels.ts",
    "db:unlock-demo": "ts-node db/unlock-demo-accounts.ts",
    "db:migrate:indexes": "ts-node db/migrations/ensure-multitenant-indexes.ts",
    "db:migrate:sites": "ts-node db/migrations/migrate-business-units-to-sites.ts",
    "db:migrate:primary-login": "ts-node db/migrations/backfill-primary-login-users.ts",
    "db:migrate:session-security": "ts-node db/migrations/backfill-session-security-fields.ts",
    "db:migrate:subscriptions": "ts-node db/migrations/normalize-active-subscriptions.ts",
    "db:migrate:admin-levels": "ts-node db/migrations/backfill-admin-levels.ts",
    "prisma:normalize": "node scripts/normalize-prisma-schema.cjs",
    "prisma:generate": "pnpm prisma:normalize && prisma generate",
    "prisma:validate": "pnpm prisma:normalize && prisma validate",
    "prisma:migrate": "pnpm prisma:normalize && prisma migrate dev",
    "prisma:deploy": "pnpm prisma:normalize && prisma migrate deploy",
    "test": "jest",
    "test:security": "jest --config jest.security.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@node-saml/node-saml": "^4.0.5",
    "argon2": "^0.40.3",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.7.0",
    "@nestjs/swagger": "^7.4.0",
    "openid-client": "^5.7.1",
    "pdf-lib": "^1.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^7.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2"
  }
}
