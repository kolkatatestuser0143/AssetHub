# MongoDB Atlas — the application database (replaces Postgres/Prisma).
# Create a free cluster at cloud.mongodb.com; the connection string is:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/itam
MONGODB_DB=itam

# Upstash managed Redis — REDIS_URL is the wire-protocol URL (TLS, rediss://)
# used by ioredis. The REST URL + token are only needed if you use the Upstash
# HTTP/REST API directly. Get all three from Upstash console → Connect.
REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_TOKEN@REPLACE_WITH_UPSTASH_ENDPOINT:6379
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_UPSTASH_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN

JWT_ACCESS_SECRET=replace-with-long-random-value
