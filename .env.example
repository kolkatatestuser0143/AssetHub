# MongoDB Atlas — application database
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/itam
MONGODB_DB=itam

# Redis
REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_TOKEN@REPLACE_WITH_UPSTASH_ENDPOINT:6379
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_UPSTASH_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-value

# Web application URL used in invitation/reset links
WEB_APP_URL=http://localhost:3000
APP_NAME=AssetHub

# Document storage — development uses Uploadcare.
# Keep the secret key server-side only; never expose it as NEXT_PUBLIC_*.
STORAGE_PROVIDER=uploadcare
UPLOADCARE_PUBLIC_KEY=replace-with-uploadcare-public-key
UPLOADCARE_SECRET_KEY=replace-with-uploadcare-secret-key
UPLOADCARE_CDN_BASE=https://ucarecdn.com

# SMTP email delivery
# Keep MAIL_ENABLED=false for local development until SMTP is configured.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=AssetHub <no-reply@example.com>
